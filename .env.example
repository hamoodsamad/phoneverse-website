# ==============================================================================
# PhoneVerse 2026 - Master Environment Configuration Template
# Copy this file to .env.local for local frontend and .env for backend/migrations
# ==============================================================================

# Application & Market Settings
NEXT_PUBLIC_APP_NAME="PhoneVerse 2026"
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
NEXT_PUBLIC_PRIMARY_MARKET="Pakistan"
PORT=3000

# 1. PostgreSQL Database (Inspect before migration; safe non-destructive DDL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/phoneverse_db?sslmode=disable"

# 2. Authentication (JWT / Session Security)
JWT_SECRET="super-secret-jwt-key-change-this-in-production-2026-min-32-chars"
JWT_EXPIRES_IN="7d"

# 3. AI Provider: OpenAI API (Modular AI comparison & smart recommendations)
# If left empty, system gracefully falls back to deterministic database-driven recommendations & comparisons
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# 4. Cloudinary Image Storage & Optimization API
# Used to store, optimize, crop, and deliver smartphone galleries
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_SECURE_DELIVERY="true"

# 5. Smartphone Data & Discovery API (Authorized Specification Provider)
# e.g., RapidAPI Phone Specifications, GSMArena authorized feed, or Custom Specs Provider
SMARTPHONE_DATA_API_URL="https://api.smartphonedata.example.com/v1"
SMARTPHONE_DATA_API_KEY=""

# 6. Smartphone Image Discovery API (Official Image Search Provider)
# Note: Keep separate from specs provider and Cloudinary as required by architecture
SMARTPHONE_IMAGE_API_URL="https://api.smartphoneimages.example.com/v1"
SMARTPHONE_IMAGE_API_KEY=""

# 7. Automated Price Tracking API (Pakistan & Global Merchants)
PRICE_TRACKING_API_URL="https://api.pricetracking.example.com/v1"
PRICE_TRACKING_API_KEY=""

# 8. Email Service (Resend or SMTP for Price Drops & Order Confirmations)
RESEND_API_KEY=""
EMAIL_FROM="orders@phoneverse.com"

# 9. Payment Gateway API (Modular: Cash on Delivery, Stripe, JazzCash, EasyPaisa)
PAYMENT_GATEWAY_PROVIDER="cod" # Options: 'cod', 'card', 'jazzcash', 'easypaisa'
PAYMENT_GATEWAY_PUBLIC_KEY=""
PAYMENT_GATEWAY_SECRET_KEY=""

# 10. Background Automation & Vercel Cron Security
CRON_SECRET="your-secure-cron-authorization-secret-2026"

# 11. Optional Persistent Rust Axum Backend URL (for cloud hosting like Fly.io or Render)
NEXT_PUBLIC_RUST_BACKEND_URL="http://127.0.0.1:8080"
